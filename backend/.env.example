# Optional: keep this key on the server. Never put it in a browser file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORT=5001

# Optional image transcription, separate from the text tutor.
# Choose openai or groq and an explicitly verified image-capable model from that provider.
# No default model/key reuse. User preview/upload consent is required on every request.
RECOGNITION_PROVIDER=
RECOGNITION_MODEL=
RECOGNITION_API_KEY=
