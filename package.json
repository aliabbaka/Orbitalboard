{
  "name": "orbitalboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A traceable, deterministic chemistry and math learning engine",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "npm run build && node scripts/demo.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "validation-report": "npm run build && node scripts/validation-report.mjs"
  },
  "devDependencies": { "typescript": "5.7.3" }
}
