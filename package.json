{
  "name": "orbitalboard",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A traceable, deterministic chemistry and math learning engine",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/offline-manifest.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "npm run build && node scripts/demo.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "validation-report": "npm run build && node scripts/validation-report.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "test:browser": "npm run build && playwright test",
    "test:backend": ".venv/bin/python -m unittest discover -s backend/tests -v"
  },
  "dependencies": { "three": "0.186.1", "qrcode-generator": "2.0.4", "fflate": "0.8.3" },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/three": "0.186.0",
    "@playwright/test": "1.64.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0"
  }
}
